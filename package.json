{
  "name": "jihao-copy-image-text",
  "version": "1.1.19",
  "description": "复制图文增强版 (Copy Image Text Plus) - Copy Obsidian note content, including local images, as rich text.",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "pnpm run typecheck && vite build && tsx scripts/copy-build-output.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run typecheck && biome check .",
    "version:bump": "tsx scripts/bump-version.ts",
    "install:local": "tsx scripts/install-local.ts",
    "release:github": "tsx scripts/release-github.ts"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "keywords": [],
  "author": "jihaohaaaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jihaohaaaa/obsidian-copy-image-text.git"
  },
  "bugs": {
    "url": "https://github.com/jihaohaaaa/obsidian-copy-image-text/issues"
  },
  "homepage": "https://github.com/jihaohaaaa/obsidian-copy-image-text#readme",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "jiti": "^2.7.0",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "tslib": "^2.8.1"
  }
}
